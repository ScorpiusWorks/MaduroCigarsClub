---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Acasă" },
  { href: "/despre-noi", label: "Despre Noi" },
  { href: "/arta-trabucului", label: "Arta Trabucului" },
  { href: "/evenimente", label: "Evenimente" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => {
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-wrapper" aria-label="Maduro Cigars Club Pagina Principală">
      <img src="/images/site/logo-MCC.png" alt="Maduro Cigars Club Logo" class="brand-logo" />
      <div class="brand-text">
        <span class="brand-title">MADURO</span>
        <span class="brand-subtitle">CIGARS CLUB</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navigare principală">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? "active" : ""}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-action">
      <a href="/contact" class="btn btn-outline nav-cta">Alătură-te Clubului</a>
      <button id="mobile-toggle" class="mobile-toggle" aria-label="Deschide meniul de navigare">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="mobile-menu">
    <nav class="container">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`mobile-nav-link ${isActive(item.href) ? "active" : ""}`}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/contact" class="btn btn-gold w-full" style="width: 100%; margin-top: 1rem;">
            Alătură-te Clubului
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(18, 18, 18, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-gold);
    transition: var(--transition-smooth);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 82px;
  }

  .brand-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .brand-logo {
    height: 48px;
    width: auto;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.7));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
    gap: 0.35rem;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent-gold-light);
    line-height: 1;
    margin: 0;
    margin-right: -0.14em; /* Compensate for trailing letter-spacing to ensure true optical centering */
  }

  .brand-subtitle {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    color: var(--accent-gold);
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
    margin-right: -0.28em; /* Compensate for trailing letter-spacing to ensure true optical centering */
  }

  .desktop-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 2rem;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    position: relative;
    padding: 0.5rem 0;
    transition: var(--transition-smooth);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-copper));
    transition: width 0.25s ease-in-out;
  }

  .nav-link:hover {
    color: var(--accent-gold-light);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-link.active {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.78rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 26px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--accent-gold);
    transition: var(--transition-smooth);
    border-radius: 2px;
  }

  .mobile-menu {
    display: none;
    background: #161616;
    border-bottom: 1px solid var(--border-gold);
    padding: 1.5rem 0;
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    display: block;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(198, 168, 124, 0.1);
  }

  .mobile-nav-link.active {
    color: var(--accent-gold);
  }

  @media (max-width: 960px) {
    .desktop-nav, .nav-cta {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById("mobile-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("open");
    });
  }
</script>

