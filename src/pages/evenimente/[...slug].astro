---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('evenimente');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const formattedDate = new Date(event.data.date).toLocaleDateString('ro-RO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${event.data.title} – Maduro Cigars Club`}
  description={event.data.description || `Galerie foto și cronica evenimentului ${event.data.title}`}
>
  <div class="container event-page-container">
    <div class="back-nav">
      <a href="/evenimente" class="back-link">&larr; Înapoi la lista de evenimente</a>
    </div>

    <header class="event-header">
      <div class="badge-gold">{formattedDate}</div>
      <h1 class="event-title">{event.data.title}</h1>
      {event.data.location && (
        <div class="event-location-tag">📍 {event.data.location}</div>
      )}
    </header>

    <!-- Narrative / Chronicle -->
    <div class="speakeasy-card chronicle-card">
      <div class="chronicle-body">
        <Content />
      </div>
    </div>

    <!-- Gallery Section -->
    {event.data.gallery && event.data.gallery.length > 0 && (
      <section class="gallery-section">
        <div class="gallery-header">
          <h2>Galerie Foto ({event.data.gallery.length} cadre)</h2>
          <p class="gallery-note">Apasă pe oricare imagine pentru vizualizare la rezoluție completă.</p>
        </div>

        <div class="gallery-grid">
          {event.data.gallery.map((imagePath, index) => (
            <a
              href={imagePath}
              target="_blank"
              rel="noopener noreferrer"
              class="gallery-item"
              title={`${event.data.title} – Cadru ${index + 1}`}
            >
              <img src={imagePath} alt={`${event.data.title} cadrul ${index + 1}`} loading="lazy" />
              <div class="gallery-overlay">
                <span class="zoom-icon">🔍 Mărește</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="event-footer-nav">
      <a href="/evenimente" class="btn btn-outline">&larr; Înapoi la Evenimente</a>
      <a href="/contact" class="btn btn-gold">Alătură-te Următoarei Întâlniri &rarr;</a>
    </div>
  </div>
</Layout>

<style>
  .event-page-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--accent-gold);
  }

  .event-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .event-title {
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    margin: 1rem 0;
    line-height: 1.2;
  }

  .event-location-tag {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: var(--accent-gold);
  }

  .chronicle-card {
    padding: 3rem;
    max-width: 860px;
    margin: 0 auto 4rem;
  }

  .chronicle-body {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .chronicle-body p {
    margin-bottom: 1.5rem;
  }

  /* Gallery Grid */
  .gallery-section {
    margin: 4rem 0;
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .gallery-note {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 190px;
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-lounge);
    background: #181818;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: rgba(18, 18, 18, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .zoom-icon {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-gold-light);
    border: 1px solid var(--border-gold);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(18, 18, 18, 0.85);
  }

  .gallery-item:hover img {
    transform: scale(1.08);
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }

  .event-footer-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-gold);
  }

  @media (max-width: 768px) {
    .chronicle-card {
      padding: 1.75rem;
    }
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 0.75rem;
    }
    .gallery-item {
      height: 140px;
    }
  }
</style>

